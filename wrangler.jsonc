{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noor-portraits-backend",
  "account_id": "414a50c18fa76da1f07ea9d3b62af7bc",
  "main": "build/noor-worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "run_worker_first": true },
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "noor-portraits-db",
    "database_id": "a4d270d9-0c2b-4831-ac98-ff5ac16a880b",
    "migrations_dir": "drizzle"
  }],
  "r2_buckets": [{
    "binding": "BUCKET",
    "bucket_name": "noor-portraits-private",
    "jurisdiction": "eu"
  }]
}
